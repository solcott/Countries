.gradle/
build/
# Don't ignore any build directories that are under a src directory
!**/src/**/build/
local.properties
.idea/
*.iml
.DS_Store
captures/
.cxx/
/.kotlin/

# Xcode. Per-user state that appears as soon as iosApp/Countries.xcodeproj is opened in the GUI —
# window layout, breakpoints, the last selected scheme. `build/` above already covers
# iosApp/build/DerivedData.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
.swiftpm/

# Claude Code. `skills/`, `agents/` and `settings.json` are project documentation and configuration
# and are committed — AGENTS.md routes to the skills by path, the agents encode this build's traps
# and output contracts, and all three are reviewable in a PR like any other doc. Everything else
# here — `settings.local.json` above all — is per-user state.
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json
